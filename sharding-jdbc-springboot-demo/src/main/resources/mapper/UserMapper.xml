<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yy.sharding.jdbc.springboot.demo.mapper.UserMapper">

    <select id="selectLikeName" resultType="com.yy.sharding.jdbc.springboot.demo.pojo.User">
        SELECT id, name, age, address
        FROM t_user
        where name like #{name}
    </select>

</mapper>
